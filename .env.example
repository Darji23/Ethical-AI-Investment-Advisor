# ==============================================================================
# Ethical AI Investment Advisor - Environment Configuration Template
# Duplicate this file as .env and fill in your actual settings / API keys.
# ==============================================================================

# Server Configuration
PORT=8000

# AI Provider API Keys
# Jina AI (for text embeddings - https://jina.ai/)
JINA_API_KEY=

# Jina Embedding Models
# Primary API-tier model (Flagship with task-specific LoRA adapters):
JINA_MODEL=jina-embeddings-v3

# Open-weight fallback model (used automatically if prime model encounters issues):
# Options: jina-embeddings-v5-text-small, jina-embeddings-v5-omni-small
JINA_FALLBACK_MODEL=jina-embeddings-v5-text-small

# Fireworks AI (for LLM inference - https://fireworks.ai/)
FIREWORKS_API_KEY=

# Fireworks AI Models
# Prime Model: State-of-the-art accuracy, ultra-fast & low-cost
FIREWORKS_MODEL=accounts/fireworks/models/deepseek-v4p1-flash

# Open-weight fallback model (used automatically if prime model encounters issues):
FIREWORKS_FALLBACK_MODEL=accounts/fireworks/models/glm-5p3-flash

# Optional local open-weights LLM tier (needs: pip install -r requirements-local-llm.txt)
# Used only without FIREWORKS_API_KEY, or when both Fireworks models fail.
# Backend: auto | mlx (Apple Silicon) | transformers. Blank model = backend default (Qwen2.5-1.5B-Instruct).
LOCAL_LLM_BACKEND=auto
LOCAL_LLM_MODEL=
LOCAL_LLM_MAX_NEW_TOKENS=768

# MongoDB Unified Cluster Configuration
# All storage connects to this MongoDB cluster across different tables/collections:
#   - investor_profiles (investor client profiles table)
#   - products          (product master catalog table)
#   - cache             (high-performance query and profile cache with TTL)
#   - advisor_logs      (compliance audit logs)
#   - blocked_recommendations
#   - system_events
MONGODB_URL=mongodb://localhost:27017
MONGODB_DB_NAME=ethical_advisor